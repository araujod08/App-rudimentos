# Neon: Dashboard > Connection string (use a pooled, com sslmode=require)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Chave que protege a API (invente uma longa). O app pede essa chave uma vez no navegador.
APP_KEY="troque-por-uma-chave-longa"
